{
  "name": "nina.fm-website",
  "version": "2.2.12",
  "private": true,
  "type": "module",
  "description": "Site public Nina.fm : Astro statique et îlots Solid",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "perf:budget": "node scripts/performance-budget.ts",
    "check:indexing": "node scripts/check-indexing.ts",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "version:check": "changeset status"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,js,mjs,css,json,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,astro,js}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.2",
    "astro": "^7.4.7",
    "date-fns": "^4.4.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@commitlint/types": "^20.4.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-solid": "^0.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.3"
    }
  },
  "packageManager": "pnpm@10.13.1"
}
