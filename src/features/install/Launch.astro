---
import LogoStroke from '~/shared/ui/LogoStroke.tsx'
import './launch.css'
---

{/* L'écran de lancement de l'app installée (website#87, dessin de website#90) : le logo
    sur le fond du thème actif, et les étapes de la mise à jour à l'ouverture (recherche,
    installation avec sa barre, version prête). Statique, montré par la feuille d'après
    `data-launch` et `data-update` sur `<html>` (`launch.ts`, `update-step.client.ts`) :
    il ne dépend d'aucun îlot, et sans script il reste caché. Persistant : le routeur ne
    le rejoue pas à chaque navigation. */}
<div class="launch" data-testid="launch" transition:persist="launch">
  <LogoStroke class="launch-logo" />
  <div class="launch-steps">
    <p class="launch-step launch-checking" role="status">
      Recherche d'une mise à jour…
    </p>
    <div class="launch-step launch-installing">
      <p class="launch-title" role="status">
        Mise à jour de Nina.fm…
      </p>
      <div
        class="launch-bar"
        role="progressbar"
        aria-label="Téléchargement de la nouvelle version"
        aria-valuemin="0"
        aria-valuemax="100"
      >
        <span></span>
      </div>
      <p class="launch-note">Une nouvelle version s'installe</p>
    </div>
    <div class="launch-step launch-ready">
      <p class="launch-title" role="status">
        <svg
          class="launch-check"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        Nina.fm est à jour
      </p>
      <p class="launch-note">Ouverture de la nouvelle version…</p>
    </div>
  </div>
</div>
