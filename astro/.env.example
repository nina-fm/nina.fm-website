# Site Astro — variables publiques, figées au build. Copier en .env pour le développement.
# En CI, elles viennent des vars NUXT_PUBLIC_* du repo (astro-validate.yml).

# Flux audio
PUBLIC_AUDIO_STREAM_URL=https://flux.nina.fm/nina.mp3

# API Nina et ses flux SSE ({API_URL}{ENDPOINT}/metadata et /activity)
PUBLIC_API_URL=https://api.nina.fm
PUBLIC_API_STREAM_ENDPOINT=/stream

# `production` seul rend le site indexable ; posée, elle exige les trois variables ci-dessus.
# PUBLIC_SITE_ENV=staging
