{
  "name": "nina.fm-website-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Site public Nina.fm en Astro + îlots Solid (migration, epic #75)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:budget": "node scripts/performance-budget.ts",
    "check:noindex": "node scripts/check-noindex.ts"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.2",
    "astro": "^7.4.7",
    "date-fns": "^4.4.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-solid": "^0.18.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.3"
    }
  },
  "packageManager": "pnpm@10.13.1"
}
