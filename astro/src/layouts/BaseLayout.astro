---
import { ClientRouter } from 'astro:transitions'
import AudioPlayer from '~/features/playback/AudioPlayer.tsx'
import Shell from '~/features/shell/Shell.tsx'
import { bootScript } from '~/features/theme/boot.ts'
import { DEFAULT_THEME } from '~/features/theme/themes.ts'
import { config } from '~/shared/site/config.ts'
import { robotsMeta, isProduction } from '~/shared/site/indexing.ts'
import { DESCRIPTION, FACEBOOK_APP_ID, SITE, STATCOUNTER, TITLE } from '~/shared/site/site.ts'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = TITLE, description = DESCRIPTION } = Astro.props
// Hors production, chaque page se ferme aux moteurs (website#76) : voir indexing.ts.
const robots = robotsMeta(config.siteEnv)
// Le staging ne compte pas dans les statistiques de la prod.
const statcounter = isProduction(config.siteEnv)
const image = new URL('/preview.png', SITE).href
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="fb:app_id" content={FACEBOOK_APP_ID} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* Navigation sans recharger le document, donc sans couper le son. */}
    <ClientRouter />
  </head>
  {/* Le thème par défaut dans le HTML : c'est lui qui reste si le script échoue. */}
  <body data-theme={DEFAULT_THEME} class={`theme-${DEFAULT_THEME}`}>
    {/* Premier enfant du `<body>`, bloquant : thème, nuit et arc-en-ciel posés avant le
        premier affichage, d'après les cookies de l'auditeur (`theme/boot.ts`). */}
    <script is:inline set:html={bootScript()} />
    <slot />
    {/* La coquille, persistante comme le lecteur : calque d'autoplay, toasts, débogueur,
        arc-en-ciel, et ce qui suit la page (classes du `<body>`, titre, clavier). */}
    <Shell client:load transition:persist="shell" transition:persist-props />
    {/* Le lecteur, hors des pages et persistant : un seul élément audio dans tout le
        site, et l'écoute qui continue d'une page à l'autre. `transition:persist-props` :
        Astro ne lui redonne jamais de propriétés, qui le remonteraient. */}
    <AudioPlayer client:load transition:persist="player" transition:persist-props />
    {/* Scripts de module : exécutés une fois par document, pas à chaque navigation. */}
    <script>
      import { registerServiceWorker } from '~/features/install/register.client.ts'
      import { reloadOnNewBuild } from '~/features/install/same-build.client.ts'
      reloadOnNewBuild()
      registerServiceWorker()
    </script>
    {statcounter && (
      <>
        <script
          is:inline
          set:html={`var sc_project=${STATCOUNTER.project};var sc_invisible=1;var sc_security="${STATCOUNTER.security}";`}
        />
        <script is:inline async src="https://www.statcounter.com/counter/counter.js" />
      </>
    )}
  </body>
</html>
